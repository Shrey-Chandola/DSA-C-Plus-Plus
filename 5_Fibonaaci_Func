//WAC++P to printf nth Fibonacci
#include<iostream>
using namespace std;

void Fibonacci(int n)
    {int a = 0, b = 1, sum = 0;
     if(n==0)   { cout << "No Series" ;  }
     else if(n==1)   { cout << "0" ;  }
     else if(n==2)  { cout << "0 1" ;  }
     else 
     {cout << "0 1" ;
        for(int i=0; i<n-2; i++)
        {sum = (a+b);
         a = b;
         b = sum;
         cout <<" " << sum ;
        }
    }
    }
int main()
{   int n = 0 ;
    cout << "Enter A Number : ";
    cin >> n;
    Fibonacci(n);
    return 0;
}
