// Change Decimal Number into Binary Number
#include<iostream>
using namespace std;
int main()
{   int n = 0, rem = 0, ans = 0, pow = 1;
    cout << "Enter the  Decimal Number : " ;
    cin >> n ;
    int e = n;
    while(n!=0)
        {rem = n%2;
         n = n/2;
         ans+=(rem*pow);   
         pow = pow * 10;
        }
    cout << "Binary equivalent of " << n << " is "<< ans;
    return 0;
}
// LOGIC : let n=6 then answer will be 110 means 1 * 10^2 + 1 * 10^1 + 0 * 10 ^ 0
// Thus we used pow = 1 and updated by pow * 10  
